# Copy to .env.local. All must be NEXT_PUBLIC_ to reach the browser.

# Monad testnet
NEXT_PUBLIC_CHAIN_ID=10143
NEXT_PUBLIC_RPC_URL=https://testnet-rpc.monad.xyz

# Deployed contracts (see packages/contracts/deployments/monadTestnet.json)
NEXT_PUBLIC_ARTICLE_REGISTRY=0x34C48D04c566131aEa6DBA8E2727423A55e38aaa
NEXT_PUBLIC_ATTENTION_STREAM=0xca364C7eC309c293216B43f6C069Ee9c5b6959cc
# like / dislike / favorite / reply / tip. Set after running
# `npm run deploy-actions:monad -w @attention-press/contracts`. Unset => the
# actions bar shows a "not configured" note and makes no calls.
NEXT_PUBLIC_ARTICLE_ACTIONS=

# Article floated to the top of discovery (the project explainer). Defaults to 8
# in code; override or set to 0 to disable.
NEXT_PUBLIC_PINNED_ARTICLE_ID=8

# Where the reader SDK POSTs signed vouchers
NEXT_PUBLIC_COLLECTOR_URL=http://localhost:8787

# Pay-rate tiers are defined in src/lib/chain.ts (RATE_TIERS) and chosen per
# article at publish time; the session budget is derived (rate × 30 min).
