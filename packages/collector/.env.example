# Copy to .env and fill in. Never commit .env.
PORT=8787
RPC_URL=https://testnet-rpc.monad.xyz
CHAIN_ID=10143
ATTENTION_STREAM_ADDRESS=0xca364C7eC309c293216B43f6C069Ee9c5b6959cc
ARTICLE_REGISTRY_ADDRESS=0x34C48D04c566131aEa6DBA8E2727423A55e38aaa
ARTICLE_ACTIONS_ADDRESS=0x04D91BC0bF42EF2bD639B565b5f53644930E80AC

# Wallet that pays gas for settle() transactions. settle() is permissionless;
# this key never receives fees or author payments — it only needs MON for gas.
# MUST be a dedicated wallet: if it's also used interactively (browser
# closeSession, scripts) the background settle loop races the same nonce and you
# get "An existing transaction had higher priority".
SETTLER_PRIVATE_KEY=0xyour_private_key_here

# How often the settle loop runs.
SETTLE_INTERVAL_MS=30000
# Skip settling deltas smaller than this (base units) to save gas. 0 = settle any.
MIN_SETTLE_DELTA=0
# Where the crash-recovery snapshot is written.
DATA_DIR=.data
# Mirror of AttentionStream.MAX_ACCRUAL_WINDOW (seconds). Change only if the contract does.
MAX_ACCRUAL_WINDOW_SEC=604800
# Comma-separated browser origins allowed to call the API (CORS).
ALLOWED_ORIGINS=http://localhost:3000

# --- reply indexer (GET /articles/:id/replies) ---
# Block to start the one-time Replied-log backfill from. ~= the ArticleActions
# deploy block; a bit earlier is fine (idempotent). 0 = from genesis (slow first run).
ARTICLE_ACTIONS_FROM_BLOCK=59015000
# How often to poll for new replies.
REPLY_INDEX_INTERVAL_MS=15000
# Max block span per eth_getLogs call. QuickNode Monad caps this at 1000, the
# public RPC at 100. 900 is a safe default; the indexer halves to a 100 floor and
# remembers the working size if a provider rejects a range.
LOG_QUERY_RANGE=900
