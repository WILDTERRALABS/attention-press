# Copy to .env and fill in before deploying. Never commit .env.
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
DEPLOYER_KEY=0xyour_private_key_here

# Payment token. Canonical Wrapped MON (WMON) on Monad testnet:
PAYMENT_TOKEN=0xFb8bf4c1CC7a94c73D209a149eA2AbEa852BC541
# Leave PAYMENT_TOKEN unset to deploy a fresh MockERC20 instead.

# Reuse an already-deployed ArticleRegistry (keeps existing articles).
# Leave unset to deploy a new one.
ARTICLE_REGISTRY=0x34C48D04c566131aEa6DBA8E2727423A55e38aaa

# Protocol fee in basis points (e.g. 250 = 2.5%). Max 1000.
PROTOCOL_FEE_BPS=250
